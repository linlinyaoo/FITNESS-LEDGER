{
  "name": "ranji-fitness-ledger",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "android:doctor": "npx cap doctor android",
    "android:apk:unsigned": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "desktop:run": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win portable",
    "test": "node --test",
    "test:model": "node scripts/check-model.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "0.577.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.ranji.fitnessledger",
    "productName": "燃记",
    "directories": {
      "output": "release-exe"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      "artifactName": "ranji-${version}-portable.${ext}",
      "signAndEditExecutable": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
